<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- Üst Başlıq (Minimalist Ağ + Tünd Yaşıl Aksent) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:gravity="center_vertical"
        android:elevation="2dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="usta."
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#2D5A3C" />

            <TextView
                android:id="@+id/tvCustHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ustalar"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressCustomer"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminateTint="#2D5A3C"
            android:visibility="gone" />
    </LinearLayout>

    <!-- TAB 1: USTALAR BÖLMƏSİ -->
    <LinearLayout
        android:id="@+id/layoutCustMasters"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <Spinner
                android:id="@+id/spinnerFilterCategory"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_rounded"
                android:paddingHorizontal="10dp"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etFilterCity"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:hint="Şəhər axtar..."
                android:textSize="14sp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:background="@drawable/bg_input_rounded"
                android:paddingHorizontal="14dp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/containerMasters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- TAB 2: SİFARİŞLƏRİM BÖLMƏSİ -->
    <LinearLayout
        android:id="@+id/layoutCustOrders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnRefreshCustOrders"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Sifarişləri Yenilə"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#2D5A3C"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="14dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/containerCustomerOrders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- TAB 3: PROFİL BÖLMƏSİ -->
    <LinearLayout
        android:id="@+id/layoutCustProfile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCustProfileInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_rounded"
            android:padding="20dp"
            android:textSize="15sp"
            android:textColor="#1E293B"
            android:lineSpacingExtra="8dp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnCustLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Hesabdan Çıxış"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:backgroundTint="#DC2626"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ALT MENYU -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavCustomer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:itemIconTint="#2D5A3C"
        app:itemTextColor="#1E293B"
        app:itemActiveIndicatorStyle="@null"
        app:menu="@menu/menu_customer" />

</LinearLayout>