<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- Üst Başlıq (Minimalist Ağ + Tünd Yaşıl Aksent) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:gravity="center_vertical"
        android:elevation="2dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="usta. paneli"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#2D5A3C" />

            <TextView
                android:id="@+id/tvMasterHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gələn Sifarişlər"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressMaster"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminateTint="#2D5A3C"
            android:visibility="gone" />
    </LinearLayout>

    <!-- TAB 1: GƏLƏN SİFARİŞLƏR -->
    <LinearLayout
        android:id="@+id/layoutMasterOrders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btnMasterRefresh"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Sifarişləri Yenilə"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#2D5A3C"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="14dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/containerMasterOrders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- TAB 2: USTA PROFİLİ -->
    <LinearLayout
        android:id="@+id/layoutMasterProfile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvMasterProfileInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_rounded"
            android:padding="20dp"
            android:textSize="15sp"
            android:textColor="#1E293B"
            android:lineSpacingExtra="8dp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnMasterLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Hesabdan Çıxış"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:backgroundTint="#DC2626"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ALT MENYU -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavMaster"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:itemIconTint="#2D5A3C"
        app:itemTextColor="#1E293B"
        app:itemActiveIndicatorStyle="@null"
        app:menu="@menu/menu_master" />

</LinearLayout>